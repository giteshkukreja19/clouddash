# ─────────────────────────────────────────────────────────────
# .env.example — Environment Variable Template
#
# INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in YOUR values below
#   3. NEVER commit the .env file to Git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────


# ── Flask Configuration ───────────────────────────────────────
# Use "development" locally, "production" on EC2
FLASK_ENV=development

# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-long-random-secret-key-here

# Server port (default: 5000)
PORT=5000


# ── Database ──────────────────────────────────────────────────
# SQLite (default — no setup needed for local dev)
DATABASE_URL=sqlite:///cloud_dashboard.db

# PostgreSQL example (uncomment and fill when migrating):
# DATABASE_URL=postgresql://username:password@localhost:5432/cloud_dashboard


# ── File Upload Settings ──────────────────────────────────────
# Max file size in megabytes
MAX_UPLOAD_MB=50

# Local temp folder for uploads
UPLOAD_FOLDER=uploads


# ── AWS Credentials ───────────────────────────────────────────
# IMPORTANT: On EC2, use an IAM Instance Role instead of keys.
#            Leave these blank on EC2 — boto3 will auto-detect the role.
#
# For local development, prefer `aws configure` and leave these empty.
# If using access keys, never commit the real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1


# ── S3 Bucket ─────────────────────────────────────────────────
# The name of your S3 bucket (must be globally unique)
# Leave blank to use local file storage instead
S3_BUCKET_NAME=


# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
